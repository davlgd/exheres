diff --git a/tests/unittests/distros/test_exherbo.py b/tests/unittests/distros/test_exherbo.py
new file mode 100644
index 0000000..ac11a31
--- /dev/null
+++ b/tests/unittests/distros/test_exherbo.py
@@ -0,0 +1,75 @@
+# This file is part of cloud-init. See LICENSE file for license information.
+
+import os
+from unittest import mock
+
+from tests.unittests.helpers import get_distro
+
+M_PATH = "cloudinit.distros.exherbo."
+# cloud-init's systemd units start it without HOME.
+NO_HOME = {"HOME": "/root"}
+
+
+class TestExherbo:
+    def test_get_distro(self):
+        distro = get_distro("exherbo")
+        assert distro.osfamily == "exherbo"
+
+    @mock.patch(M_PATH + "subp.subp")
+    def test_package_command_install(self, m_subp):
+        get_distro("exherbo").package_command(
+            "install", pkgs=["app-editors/vim", ("sys-apps/htop", "3.4.1")]
+        )
+        m_subp.assert_called_once_with(
+            [
+                "cave",
+                "resolve",
+                "--execute",
+                "app-editors/vim",
+                "=sys-apps/htop-3.4.1",
+            ],
+            capture=False,
+            update_env={"HOME": mock.ANY},
+        )
+
+    @mock.patch.dict(os.environ, clear=True)
+    @mock.patch(M_PATH + "subp.subp")
+    def test_install_packages_syncs_first(self, m_subp):
+        get_distro("exherbo").install_packages(["sys-process/htop"])
+        assert m_subp.call_args_list == [
+            mock.call(["cave", "sync"], capture=False, update_env=NO_HOME),
+            mock.call(
+                ["cave", "resolve", "--execute", "sys-process/htop"],
+                capture=False,
+                update_env=NO_HOME,
+            ),
+        ]
+
+    @mock.patch(M_PATH + "subp.subp")
+    def test_package_command_upgrade(self, m_subp):
+        get_distro("exherbo").package_command("upgrade")
+        m_subp.assert_called_once_with(
+            ["cave", "resolve", "--execute", "world"],
+            capture=False,
+            update_env={"HOME": mock.ANY},
+        )
+
+    @mock.patch(M_PATH + "update_locale_conf")
+    @mock.patch(
+        M_PATH + "subp.subp", return_value=("C.utf8\nen_US.utf8\n", "")
+    )
+    def test_apply_locale_already_compiled(self, m_subp, m_update):
+        get_distro("exherbo").apply_locale("en_US.UTF-8")
+        m_subp.assert_called_once_with(["localedef", "--list-archive"])
+        m_update.assert_called_once_with(
+            "/etc/locale.conf", {"LANG": "en_US.UTF-8"}
+        )
+
+    @mock.patch(M_PATH + "update_locale_conf")
+    @mock.patch(M_PATH + "subp.subp", return_value=("C.utf8\n", ""))
+    def test_apply_locale_compiles_missing(self, m_subp, m_update):
+        get_distro("exherbo").apply_locale("fr_FR.UTF-8")
+        m_subp.assert_called_with(
+            ["localedef", "-i", "fr_FR", "-f", "UTF-8", "fr_FR.UTF-8"],
+            capture=False,
+        )
