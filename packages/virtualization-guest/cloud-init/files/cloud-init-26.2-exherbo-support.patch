diff --git a/cloudinit/distros/exherbo.py b/cloudinit/distros/exherbo.py
new file mode 100644
index 0000000..21900d5
--- /dev/null
+++ b/cloudinit/distros/exherbo.py
@@ -0,0 +1,113 @@
+# This file is part of cloud-init. See LICENSE file for license information.
+
+import logging
+import os
+
+from cloudinit import distros, helpers, subp, util
+from cloudinit.distros import PackageList
+from cloudinit.distros.aosc import update_locale_conf
+from cloudinit.distros.parsers.hostname import HostnameConf
+from cloudinit.settings import PER_ALWAYS, PER_INSTANCE
+
+LOG = logging.getLogger(__name__)
+
+
+class Distro(distros.Distro):
+    systemd_locale_conf_fn = "/etc/locale.conf"
+    init_cmd = ["systemctl"]
+    tz_local_fn = "/etc/localtime"
+    usr_lib_exec = "/usr/libexec"
+    default_locale = "en_US.UTF-8"
+
+    def __init__(self, name, cfg, paths):
+        distros.Distro.__init__(self, name, cfg, paths)
+        self._runner = helpers.Runners(paths)
+        self.osfamily = "exherbo"
+        cfg["ssh_svcname"] = "sshd"
+
+    def apply_locale(self, locale, out_fn=None):
+        if not out_fn:
+            out_fn = self.systemd_locale_conf_fn
+        # glibc on Exherbo ships a prebuilt locale-archive and no locale-gen:
+        # only compile the locale when it is missing
+        out, _ = subp.subp(["localedef", "--list-archive"])
+        wanted = locale.lower().replace("utf-8", "utf8")
+        if wanted not in out.lower().split():
+            name, _, charset = locale.partition(".")
+            subp.subp(
+                ["localedef", "-i", name, "-f", charset or "UTF-8", locale],
+                capture=False,
+            )
+        update_locale_conf(out_fn, {"LANG": locale})
+
+    def install_packages(self, pkglist: PackageList):
+        self.update_package_sources()
+        self.package_command("install", pkgs=pkglist)
+
+    def _write_hostname(self, hostname, filename):
+        create_hostname_file = util.get_cfg_option_bool(
+            self._cfg, "create_hostname_file", True
+        )
+        if not create_hostname_file:
+            LOG.info(
+                "create_hostname_file is False; hostname file not created"
+            )
+            return
+        conf = HostnameConf("")
+        conf.set_hostname(hostname)
+        util.write_file(filename, str(conf), omode="w", mode=0o644)
+
+    def _read_system_hostname(self):
+        return (
+            self.hostname_conf_fn,
+            self._read_hostname(self.hostname_conf_fn),
+        )
+
+    def _read_hostname(self, filename, default=None):
+        try:
+            conf = HostnameConf(util.load_text_file(filename))
+            conf.parse()
+            return conf.hostname or default
+        except IOError:
+            return default
+
+    def _apply_hostname(self, hostname):
+        try:
+            subp.subp(["hostnamectl", "--transient", "set-hostname", hostname])
+        except subp.ProcessExecutionError:
+            util.logexc(
+                LOG, "Failed to set the transient hostname %s", hostname
+            )
+
+    def set_timezone(self, tz):
+        distros.set_etc_timezone(tz=tz, tz_file=self._find_tz_file(tz))
+
+    def package_command(self, command, args=None, pkgs=None):
+        cmd = ["cave", "resolve", "--execute"]
+        if args and isinstance(args, str):
+            cmd.append(args)
+        elif args and isinstance(args, list):
+            cmd.extend(args)
+        if command == "upgrade":
+            cmd.append("world")
+        else:
+            cmd.extend(util.expand_package_list("=%s-%s", pkgs or []))
+        self._cave(cmd)
+
+    def update_package_sources(self, *, force=False):
+        self._runner.run(
+            "update-sources",
+            self._cave,
+            [["cave", "sync"]],
+            freq=PER_ALWAYS if force else PER_INSTANCE,
+        )
+
+    @staticmethod
+    def _cave(cmd):
+        # cave refuses to start without HOME, which cloud-init's systemd
+        # units do not set.
+        subp.subp(
+            cmd,
+            capture=False,
+            update_env={"HOME": os.environ.get("HOME", "/root")},
+        )
