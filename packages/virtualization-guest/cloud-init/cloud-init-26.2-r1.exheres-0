require github [ user=canonical tag=${PV} ]
require python [ blacklist=2 multibuild=false ]
require meson
require bash-completion systemd-service

SUMMARY="Multi-distribution method for cross-platform cloud instance initialisation"
DESCRIPTION="
cloud-init configures a cloud instance at boot from the metadata and user data its platform
provides: users and SSH keys, hostname, network, packages, files and commands to run.
"
HOMEPAGE="https://cloud-init.io"

LICENCES="|| ( Apache-2.0 GPL-3 )"
SLOT="0"
PLATFORMS="~amd64 ~armv8"
MYOPTIONS=""

# Unit tests need pytest, pytest-mock, responses and passlib
RESTRICT="test"

DEPENDENCIES="
    build:
        virtual/pkg-config
        dev-python/Jinja2[python_abis:*(-)?]
        dev-python/PyYAML[python_abis:*(-)?]
        dev-python/requests[python_abis:*(-)?]
    build+run:
        sys-apps/systemd
    run:
        dev-python/configobj[python_abis:*(-)?]
        dev-python/Jinja2[python_abis:*(-)?]
        dev-python/jsonpatch[python_abis:*(-)?]
        dev-python/PyYAML[python_abis:*(-)?]
        dev-python/requests[python_abis:*(-)?]
        net/netcat-openbsd [[ note = [ The units signal each stage with nc -U ] ]]
        sys-apps/iproute2
        sys-apps/shadow
        sys-apps/util-linux
    suggestion:
        app-admin/sudo [[ description = [ Sudo rules for the users cloud-init creates ] ]]
        dev-python/jsonschema[python_abis:*(-)?] [[ description = [ Validate cloud-config against its schema ] ]]
        dev-python/oauthlib[python_abis:*(-)?] [[ description = [ The MAAS datasource and webhook reporting ] ]]
        net-misc/dhcpcd [[ description = [ Ephemeral DHCP for datasources reached over the network ] ]]
        sys-fs/e2fsprogs [[ description = [ Resize ext4 root filesystems ] ]]
        sys-fs/growpart [[ description = [ Grow the root partition on first boot ] ]]
"

DEFAULT_SRC_PREPARE_PATCHES=(
    "${FILES}"/${PNV}-exherbo-support.patch
)

MESON_SRC_CONFIGURE_PARAMS=(
    -Dbash_completion=false
    -Ddisable_sshd_keygen=false
    -Ddownstream_version=${PVR}
    -Dinit_system=systemd
)

src_prepare() {
    meson_src_prepare

    # respect selected python abi
    edo sed \
        -e "1s:#!/usr/bin/env python3:#!/usr/bin/env python$(python_get_abi):" \
        -i scripts/cloud-id scripts/cloud-init tools/render-template
}

src_install() {
    meson_src_install

    # scripts run by 'cloud-init clean'
    keepdir /etc/cloud/clean.d

    dobashcompletion bash_completion/cloud-init
}

