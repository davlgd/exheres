require go [ go_minimum_version=1.26.0 ] github [ user="jesseduffield" tag=v${PV} ]

SUMMARY="Simple terminal UI for git commands"

LICENCES="MIT"
SLOT="0"
PLATFORMS="~amd64 ~armv7 ~armv8"
MYOPTIONS=""

DEPENDENCIES="
    run:
        dev-scm/git
"

GO_SRC_COMPILE_LDFLAGS=(
    "-X main.version=${PV}"
)

